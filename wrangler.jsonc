{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aksen-fx-desk",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "account_id": "86fe5ad88f569cb859952f090b459cbf",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SITE_URL": "https://aksen-fx-desk.bishoptewogbade.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
