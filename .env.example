# OpenRouter / LLM Integration
OPENROUTER_API_KEY="sk-or-v1-***"

# WhatsApp Cloud API (Production Integration)
WHATSAPP_ACCESS_TOKEN="EAAB..."
WHATSAPP_PHONE_NUMBER_ID="10987654321"
WHATSAPP_VERIFY_TOKEN="aksen_otc_token"
WHATSAPP_WEBHOOK_SECRET=""
# Susu transactional SMS. Approved sender must be 1-11 letters, numbers, spaces or hyphens.
# Keep sandbox true until a designated phone test has passed.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
ARKESEL_SANDBOX=true
# Reserved for Arkesel's signed SMS callback once its exact signing contract is confirmed.
# Delivery currently uses authenticated SMS-details polling instead.
ARKESEL_WEBHOOK_SECRET=
# Random secret shared with the Cloudflare scheduled handler.
SUSU_SMS_CRON_SECRET=
