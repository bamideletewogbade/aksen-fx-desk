{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["worker/**/*.ts"]
}
